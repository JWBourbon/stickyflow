# ==============================================================================
# StickyFlow - Environment Configuration Template
# Copy this file to '.env' and fill in your actual credentials.
# NEVER commit your real '.env' file to version control.
# ==============================================================================

# Server Port
PORT=3000

# Google Gemini API Key
# Obtain your free API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Discord Bot Token
# Obtain your bot token from the Discord Developer Portal: https://discord.com/developers/applications
DISCORD_BOT_TOKEN=your_discord_bot_token_here
